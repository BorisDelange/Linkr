{
  "name": "linkr",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "cd apps/web && npm run test",
    "dev:web": "cd apps/web && npm run dev",
    "dev:client": "cd apps/web && npm run dev:client",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload --reload-dir app --port 8000",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "packageManager": "npm@11.5.2",
  "devDependencies": {
    "turbo": "^2"
  }
}
