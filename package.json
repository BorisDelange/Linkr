{
  "name": "linkr",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "cd apps/web && npm run test",
    "test:api": "cd apps/api && .venv/bin/python -m pytest -q -p no:cacheprovider -n 4 --timeout=120",
    "test:e2e": "cd apps/web && npx playwright test",
    "test:matrix": "node scripts/test-matrix.mjs",
    "test:spe": "node scripts/test-spe.mjs",
    "test:versioning": "node scripts/test-versioning.mjs",
    "dev:web": "cd apps/web && npm run dev",
    "dev:client": "cd apps/web && npm run dev:client",
    "build:client": "cd apps/web && npm run build:client",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:mcp": "npm run start:http --workspace @linkr/mcp",
    "worktree:new": "node scripts/new-worktree.mjs",
    "worktree:remove": "node scripts/remove-worktree.mjs",
    "worktree:status": "node scripts/worktree-status.mjs",
    "data:fetch": "tsx scripts/fetch-default-data.ts",
    "duckdb:extensions": "node scripts/duckdb-extensions.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "packageManager": "npm@11.5.2",
  "devDependencies": {
    "turbo": "^2",
    "tsx": "^4.19.2"
  }
}
