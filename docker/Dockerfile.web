# syntax=docker/dockerfile:1.7
# ^ modern BuildKit frontend on older Docker engines (ARG-in-ARG defaults).
# Build context is the repo root (see docker-compose.yml).
# Build stage
FROM node:22-alpine AS build
WORKDIR /app

# Monorepo: the lockfile lives at the root (npm workspaces). Copy the root
# manifests + the whole web workspace, then `npm ci` the web workspace. The web
# postinstall (copies DuckDB .wasm into apps/web/public/) needs the workspace
# source present, so we copy it before installing.
COPY package.json package-lock.json ./
# The build stamps the export-format version into project.json (appVersion) from
# the repo-root VERSION file (vite.config.ts reads ../../VERSION → /app/VERSION).
# It MUST be present or vite falls back to "0.0.0" and diverges from the API's
# stamp — a mixed front/back diff. Keep this in sync with Dockerfile.api.
COPY VERSION ./VERSION
COPY apps/web/ apps/web/
# The web build resolves the `@default-plugins` and `@linkr/format` path aliases
# to these workspaces (vite + tsconfig), so they must be present at the same
# relative location. Both aliases point straight at the SOURCE
# (packages/<name>/src/…), not a built dist, so copying the source is enough —
# but the copy is not optional: 28 files under apps/web/src import
# `@linkr/format`, and without it `tsc -b` fails with TS2307 before vite runs.
COPY packages/default-plugins/ packages/default-plugins/
COPY packages/linkr-format/ packages/linkr-format/
# --ignore-scripts skips the root `prepare` (install-git-hooks.mjs — dev-only, no
# .git here); then run the web postinstall explicitly to copy the DuckDB .wasm.
RUN npm ci --workspace web --ignore-scripts \
    && npm run postinstall --workspace web

WORKDIR /app/apps/web
# Server mode: a truthy VITE_API_URL makes isServerMode() true at build time.
# "/" keeps API calls relative (/api/v1/...), so nginx proxies them to the api
# service — the backend URL is never baked into the bundle. Empty = front-only.
#
# Sub-path deployment (reverse proxy serving the app under /my-prefix/): set
# BASE_PATH=/my-prefix/ — it prefixes assets + router basename, and becomes the
# VITE_API_URL default so API/WS calls carry the prefix too. Works whether the
# proxy strips the prefix or forwards it (the serve stage drops it, see below).
ARG BASE_PATH=/
ENV BASE_PATH=$BASE_PATH
ARG VITE_API_URL=$BASE_PATH
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Serve stage
FROM nginx:alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# A proxy that forwards the prefix sends /my-prefix/assets/…, but files and the
# /api/ and /ws/ routes live at the root: drop the prefix and route again.
# Trimmed like normalizeBasePath (vite.config.ts), and limited to plain path
# characters so it is safe inside the sed expression and the nginx regex.
ARG BASE_PATH=/
RUN prefix=$(printf '%s' "$BASE_PATH" | sed -E 's#^/+##; s#/+$##') \
    && if [ -n "$prefix" ]; then \
         printf '%s' "$prefix" | grep -Eq '^[A-Za-z0-9._~/-]+$' \
           || { echo "BASE_PATH must be a plain path, got: $BASE_PATH" >&2; exit 1; }; \
         sed -i "s#^    \# @base-path-rule@#    location ^~ /$prefix/ { rewrite ^/$prefix/(.*)\$ /\$1 last; }#" \
           /etc/nginx/conf.d/default.conf \
         && grep -qF "location ^~ /$prefix/" /etc/nginx/conf.d/default.conf; \
       fi
EXPOSE 80
