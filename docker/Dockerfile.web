# Build context is the repo root (see docker-compose.yml).
# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
# Server mode: a truthy VITE_API_URL makes isServerMode() true at build time.
# "/" keeps API calls relative (/api/v1/...), so nginx proxies them to the api
# service — the backend URL is never baked into the bundle. Empty = front-only.
ARG VITE_API_URL=/
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Serve stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
