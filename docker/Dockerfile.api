# Build context is the repo root (see docker-compose.yml).
#
# Base on rocker/r-ver (R + Posit Package Manager binary repo, incl. arm64) so
# the R packages install as prebuilt binaries in seconds — `arrow` in particular
# isn't in Debian and compiling it from source on ARM is very slow. This is an
# Ubuntu image; we add Python 3.12 (noble ships it) for the FastAPI backend.
FROM rocker/r-ver:latest

WORKDIR /app

# Python (for the API) + Rscript is already present. r-cran-* aren't used —
# we install the R packages from p3m below as binaries.
# git + git-lfs power server-side project/mapping versioning: git for
# clone/commit/push, git-lfs so large data files (similarity-scores.parquet,
# big CSVs) are stored as LFS objects rather than bloating the repo.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    git \
    git-lfs \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# R packages for server-side execution: arrow (Parquet dataset injection),
# svglite (standalone SVG device), jsonlite + base64enc (persistent R kernel
# wire protocol — see execution/kernel.py). Binary installs from p3m (fast).
RUN Rscript -e 'options(Ncpus=parallel::detectCores()); install.packages(c("arrow","svglite","jsonlite","base64enc"))' \
    && Rscript -e 'library(arrow); library(svglite); library(jsonlite); library(base64enc)'

# Python deps in a venv (Ubuntu 24.04 blocks system pip via PEP 668).
# Execution extras: pandas, matplotlib, pyarrow, scipy, statsmodels, lifelines.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# The full source is needed for the editable install (hatchling packages `app`).
COPY apps/api/ ./
RUN pip install --no-cache-dir -e ".[execution]"

# Pre-bundle DuckDB extensions into the image so an offline deployment never
# needs to reach the network on first use. They install under
# <dir>/v<ver>/<platform>/; the entrypoint seeds the runtime data volume's
# extension dir from here. `excel` powers native .xlsx reads (mapping/datasets);
# postgres/mysql/sqlite back the external-database connectors.
ENV LINKR_DUCKDB_EXT_BUNDLE=/opt/duckdb_ext
RUN python3 - <<'PY'
import duckdb, os
d = os.environ["LINKR_DUCKDB_EXT_BUNDLE"]
con = duckdb.connect()
con.execute(f"SET extension_directory = '{d}'")
for ext in ("excel", "postgres", "mysql", "sqlite"):
    con.execute(f"INSTALL {ext}")
PY

COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

EXPOSE 8000

# Migrate then serve (see api-entrypoint.sh).
CMD ["/usr/local/bin/api-entrypoint.sh"]
