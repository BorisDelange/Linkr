# Build context is the repo root (see docker-compose.yml).
FROM python:3.12-slim

WORKDIR /app

# Install system deps. R packages: svglite (standalone SVG device, no X11/cairo),
# jsonlite + base64enc (persistent R kernel wire protocol — see execution/kernel.py).
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    r-cran-svglite \
    r-cran-jsonlite \
    r-cran-base64enc \
    r-cran-arrow \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (with server-side execution extras: pandas, matplotlib,
# pyarrow, scipy, statsmodels, lifelines — needed by the server-side viz components)
COPY apps/api/pyproject.toml .
RUN pip install --no-cache-dir -e ".[execution]"

COPY apps/api/ ./

COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

EXPOSE 8000

# Migrate then serve (see api-entrypoint.sh).
CMD ["/usr/local/bin/api-entrypoint.sh"]
