FROM python:3.12-slim

WORKDIR /app

# Install system deps. r-cran-svglite gives R a standalone SVG graphics device
# for server-side plot capture (no X11/cairo runtime dependency).
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    r-cran-svglite \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (with server-side execution extras: pandas, matplotlib)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[execution]"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
