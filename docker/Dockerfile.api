FROM python:3.12-slim

WORKDIR /app

# Install system deps. R packages: svglite (standalone SVG device, no X11/cairo),
# jsonlite + base64enc (persistent R kernel wire protocol — see execution/kernel.py).
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    r-cran-svglite \
    r-cran-jsonlite \
    r-cran-base64enc \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (with server-side execution extras: pandas, matplotlib)
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[execution]"

COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
