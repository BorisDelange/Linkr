# Docker Compose reads this file automatically (it sits next to docker-compose.yml)
# and uses it to interpolate ${...} in the compose file.
#
# Copy to docker/.env (git-ignored) and fill in a real secret:
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
# Generate the key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signing key of the JWT tokens, at least 32 characters. REQUIRED: compose refuses
# to start while it is empty, and the API warns on a short or example value. Keep it
# stable: rotating it invalidates existing sessions.
LINKR_SECRET_KEY=

# Asked by the setup page to create the first administrator. Leave empty to read a
# generated one in the API's log (docker compose logs api | grep setup_token); set
# it for a deployment whose operator has no access to that log.
LINKR_SETUP_TOKEN=
