# Docker Compose reads this file automatically (it sits next to docker-compose.yml)
# and uses it to interpolate ${...} in the compose file.
#
# Copy to docker/.env (git-ignored) and fill in a real secret:
#   cp docker/.env.example docker/.env
#   chmod 600 docker/.env
# Generate the key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Signing key: JWT tokens + Fernet encryption of stored data-source passwords.
# REQUIRED — compose refuses to start without it. Keep it stable: rotating it
# invalidates existing sessions and makes previously stored DB secrets unreadable.
LINKR_SECRET_KEY=change-me
