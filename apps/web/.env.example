# Linkr web configuration. Copy to .env.local to override.

# Server mode: set to the backend URL to enable auth + API-backed storage.
# Leave unset (or empty) for local/front-only mode (IndexedDB, no backend).
VITE_API_URL=http://localhost:8000

# Dev ports. Only needed when running several git worktrees side by side —
# scripts/new-worktree.mjs allocates a free pair and writes them here. Unset
# means 3000/8000. Keep API_PORT and the port in VITE_API_URL identical, or the
# frontend will talk to another worktree's backend.
# WEB_PORT=3000
# API_PORT=8000

# Remote dev (VS Code container, devbox, VM) — the browser is not on the machine
# running vite. Unset, these keep vite's localhost-only defaults.
#
# Listen beyond loopback, so the port is reachable from outside the container:
# WEB_HOST=0.0.0.0
#
# Hostnames vite may serve. A reverse proxy sends its own Host header, which
# vite rejects with "Blocked request. This host is not allowed." Comma-separated;
# a leading dot matches subdomains (.example.org). "true" disables the check —
# private networks only, it reopens the DNS-rebinding hole the check closes.
# WEB_ALLOWED_HOSTS=chu-example.fr
#
# Sub-path behind a proxy that does NOT strip the prefix. Prefixes assets and
# the router basename. Leave unset when the proxy strips it — the app then sees
# "/" and a prefix here would break every asset URL.
# BASE_PATH=/container-3612/
#
# HMR behind a TLS-terminating proxy: the page loads over https on 443, so the
# websocket must too, or it dials ws://<proxy>:<WEB_PORT> and retries forever.
# WEB_HMR_PROTOCOL=wss
# WEB_HMR_CLIENT_PORT=443
# WEB_HMR_HOST=chu-example.fr
