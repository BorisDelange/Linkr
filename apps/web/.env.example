# Linkr web configuration. Copy to .env.local to override.

# Server mode: set to the backend URL to enable auth + API-backed storage.
# Leave unset (or empty) for local/front-only mode (IndexedDB, no backend).
VITE_API_URL=http://localhost:8000

# Dev ports. Only needed when running several git worktrees side by side —
# scripts/new-worktree.mjs allocates a free pair and writes them here. Unset
# means 3000/8000. Keep API_PORT and the port in VITE_API_URL identical, or the
# frontend will talk to another worktree's backend.
# WEB_PORT=3000
# API_PORT=8000
