# Linkr API configuration. All vars are prefixed LINKR_.
#
# This file is a template. In DEV, copy it to .env (auto-loaded on startup).
# In PRODUCTION, prefer injecting these as environment variables via your
# service manager (systemd EnvironmentFile= with chmod 600, or Docker
# env_file / secrets) rather than shipping a .env on disk. See README.

# --- Data directory ---------------------------------------------------------
# Where Linkr stores its data. In a clean deployment, point this at a dedicated
# folder; the SQLite database and all binary blobs (Parquet, attachments, IDE
# files) then live together here.
LINKR_DATA_DIR=~/.linkr

# --- Database ---------------------------------------------------------------
# Leave UNSET to use a SQLite file inside LINKR_DATA_DIR (single-user, default).
# Set it explicitly for PostgreSQL (multi-user). Same models on both engines.
# LINKR_DATABASE_URL=postgresql+asyncpg://linkr:linkr@localhost:5432/linkr
# Explicit SQLite path also works (4 slashes = absolute path):
# LINKR_DATABASE_URL=sqlite+aiosqlite:////var/lib/linkr/linkr.db

# --- Auth -------------------------------------------------------------------
# CHANGE this in any real deployment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LINKR_SECRET_KEY=dev-secret-change-in-production
LINKR_ALGORITHM=HS256
LINKR_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LINKR_REFRESH_TOKEN_EXPIRE_DAYS=30
LINKR_AUTH_PROVIDER=local

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
LINKR_CORS_ORIGINS=http://localhost:3000

LINKR_DEBUG=false
