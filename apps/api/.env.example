# Linkr API configuration (all vars prefixed LINKR_). Copy to .env to override.

# Database — SQLite (single-user) or PostgreSQL (multi-user). Same models on both.
LINKR_DATABASE_URL=sqlite+aiosqlite:///./linkr.db
# LINKR_DATABASE_URL=postgresql+asyncpg://linkr:linkr@localhost:5432/linkr

# Auth — CHANGE the secret in any real deployment.
LINKR_SECRET_KEY=dev-secret-change-in-production
LINKR_ALGORITHM=HS256
LINKR_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LINKR_REFRESH_TOKEN_EXPIRE_DAYS=30
LINKR_AUTH_PROVIDER=local

# CORS — comma-separated list of allowed frontend origins.
LINKR_CORS_ORIGINS=http://localhost:3000

# Storage for binary blobs (Parquet, attachments, IDE files).
LINKR_DATA_DIR=~/.linkr

LINKR_DEBUG=false
