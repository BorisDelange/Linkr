# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store

# Environment — ignore every .env* variant (secrets), keep the committed templates
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log

# Local notes / roadmaps (not shared with the team)
*.local.md

# Data files
*.db
*.sqlite
*.parquet
*.csv
*.tsv
*.xlsx
*.xls
*.duckdb
*.arrow

# ...but the dependabot triage log is a tracked decision record, not data
!.claude/skills/dependabot-triage/TRIAGE-LOG.csv
*.feather

# Golden test fixtures are versioned content, not data — the export format
# contract needs its expected files (incl. .csv) tracked (see server-export-plan).
!apps/web/src/lib/**/__fixtures__/**

# The default data is no longer committed: it is one published workspace
# (`demo-workspace`), fetched and baked into the seed at build time by
# `npm run data:fetch`. So this whole folder is a build artefact — including the
# seed-hashes.json the vite plugin writes. See docs/planning/default-data-repos-plan.md.
apps/web/public/data/

# ETL test directory
tests-etl/

# Turbo
.turbo/

# R (v1 legacy)
.Rbuildignore
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Local skill configuration (machine-specific paths, never commit)
config.local.json

# Local design prototypes (not part of the build)
.prototypes/

# Clones made by scripts/fetch-default-data.ts, keyed <repo>@<ref>. A build cache:
# pinned refs make it a perfect hit, and deleting it only costs one re-clone.
.cache/
