{
  "id": "linkr-analysis-survey-question",
  "name": {
    "en": "Survey question",
    "fr": "Question de questionnaire"
  },
  "description": {
    "en": "Analyse one questionnaire question (eCRF, Goupile, REDCap): response rate, answer distribution, and the chart that fits its type — including multiple-choice questions whose options span several columns.",
    "fr": "Analyse une question de questionnaire (eCRF, Goupile, REDCap) : taux de réponse, distribution des réponses et le graphique adapté à son type — y compris les questions à choix multiples dont les options occupent plusieurs colonnes."
  },
  "version": "1.0.0",
  "category": "visualization",
  "tags": [
    "survey",
    "questionnaire",
    "ecrf",
    "goupile",
    "redcap",
    "likert"
  ],
  "runtime": [
    "component"
  ],
  "languages": [],
  "icon": "ClipboardList",
  "iconColor": "teal",
  "configSchema": {
    "chart": {
      "type": "select",
      "label": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "default": "auto",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Only the charts that fit the selected question are offered — a pie asserts a part-to-whole relationship a multiple-choice question does not have.",
        "fr": "Seuls les graphiques adaptés à la question sélectionnée sont proposés — un camembert affirme une relation partie-tout qu'une question à choix multiples n'a pas."
      },
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Auto",
            "fr": "Auto"
          }
        },
        {
          "value": "answers",
          "label": {
            "en": "Answer list",
            "fr": "Liste des réponses"
          }
        },
        {
          "value": "bar",
          "label": {
            "en": "Horizontal bars",
            "fr": "Barres horizontales"
          }
        },
        {
          "value": "column",
          "label": {
            "en": "Vertical bars",
            "fr": "Barres verticales"
          }
        },
        {
          "value": "pie",
          "label": {
            "en": "Pie",
            "fr": "Camembert"
          }
        },
        {
          "value": "donut",
          "label": {
            "en": "Donut",
            "fr": "Anneau"
          }
        },
        {
          "value": "histogram",
          "label": {
            "en": "Histogram",
            "fr": "Histogramme"
          }
        },
        {
          "value": "stats",
          "label": {
            "en": "Summary statistics",
            "fr": "Statistiques descriptives"
          }
        },
        {
          "value": "table",
          "label": {
            "en": "Table",
            "fr": "Tableau"
          }
        }
      ],
      "filterOptionsBySurveyQuestion": "questionColumn"
    },
    "title": {
      "type": "string",
      "label": {
        "en": "Title",
        "fr": "Titre"
      },
      "default": "",
      "optional": true,
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Overrides the question text. Leave empty to use the question as asked.",
        "fr": "Remplace le texte de la question. Laisser vide pour utiliser la question telle que posée."
      }
    },
    "bins": {
      "type": "number",
      "label": {
        "en": "Bins",
        "fr": "Classes"
      },
      "default": 0,
      "min": 0,
      "max": 100,
      "row": "histRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "visibleWhen": {
        "field": "chart",
        "values": [
          "histogram"
        ]
      },
      "description": {
        "en": "0 picks a bin count from the data.",
        "fr": "0 choisit un nombre de classes d'après les données."
      }
    },
    "showMedian": {
      "type": "boolean",
      "label": {
        "en": "Median line",
        "fr": "Médiane"
      },
      "default": true,
      "row": "histRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "visibleWhen": {
        "field": "chart",
        "values": [
          "histogram"
        ]
      }
    },
    "questionColumn": {
      "type": "column-select",
      "multi": false,
      "label": {
        "en": "Question",
        "fr": "Question"
      },
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Any column of the question. For a multiple-choice question, picking one of its options selects the whole question.",
        "fr": "N'importe quelle colonne de la question. Pour une question à choix multiples, choisir une de ses options sélectionne la question entière."
      },
      "optionHint": "survey"
    },
    "sort": {
      "type": "select",
      "label": {
        "en": "Sort",
        "fr": "Tri"
      },
      "default": "frequency",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Scales always keep their questionnaire order — sorting a 1-to-5 scale by frequency would destroy its meaning. Custom lets you drag the answers into any order.",
        "fr": "Les échelles conservent toujours l'ordre du questionnaire — trier une échelle de 1 à 5 par fréquence détruirait son sens. Personnalisé permet de glisser les réponses dans l'ordre voulu."
      },
      "options": [
        {
          "value": "frequency",
          "label": {
            "en": "By frequency",
            "fr": "Par fréquence"
          }
        },
        {
          "value": "declared",
          "label": {
            "en": "Questionnaire order",
            "fr": "Ordre du questionnaire"
          }
        },
        {
          "value": "alphabetical",
          "label": {
            "en": "Alphabetical",
            "fr": "Alphabétique"
          }
        },
        {
          "value": "custom",
          "label": {
            "en": "Custom (drag to reorder)",
            "fr": "Personnalisé (glisser pour réordonner)"
          }
        }
      ]
    },
    "choiceOrder": {
      "type": "choice-order",
      "label": {
        "en": "Answer order",
        "fr": "Ordre des réponses"
      },
      "columnField": "questionColumn",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "visibleWhen": {
        "field": "sort",
        "value": "custom"
      },
      "description": {
        "en": "Drag the answers into the order the chart should read.",
        "fr": "Glissez les réponses dans l'ordre de lecture du graphique."
      }
    },
    "maxChoices": {
      "type": "number",
      "label": {
        "en": "Max options",
        "fr": "Options au maximum"
      },
      "default": 0,
      "min": 0,
      "max": 100,
      "row": "dataOpts",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "0 shows every option. Otherwise the rest are grouped as 'Others'.",
        "fr": "0 affiche toutes les options. Sinon les autres sont regroupées en « Autres »."
      }
    },
    "hideEmptyChoices": {
      "type": "boolean",
      "label": {
        "en": "Hide unpicked",
        "fr": "Masquer non choisies"
      },
      "default": false,
      "row": "dataOpts",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "An option nobody picked is a finding in itself, so it is shown by default.",
        "fr": "Une option que personne n'a choisie est un résultat en soi, elle est donc affichée par défaut."
      }
    },
    "valueLabel": {
      "type": "select",
      "label": {
        "en": "Bar labels",
        "fr": "Étiquettes"
      },
      "default": "both",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      },
      "options": [
        {
          "value": "both",
          "label": {
            "en": "n and %",
            "fr": "n et %"
          }
        },
        {
          "value": "count",
          "label": {
            "en": "Count",
            "fr": "Effectif"
          }
        },
        {
          "value": "percent",
          "label": {
            "en": "Percentage",
            "fr": "Pourcentage"
          }
        },
        {
          "value": "none",
          "label": {
            "en": "None",
            "fr": "Aucune"
          }
        }
      ]
    },
    "showQuestionText": {
      "type": "boolean",
      "label": {
        "en": "Question text",
        "fr": "Texte de la question"
      },
      "default": true,
      "row": "checksRow",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      }
    },
    "showGrid": {
      "type": "boolean",
      "label": {
        "en": "Grid",
        "fr": "Grille"
      },
      "default": true,
      "row": "checksRow2",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      },
      "visibleWhen": {
        "field": "chart",
        "values": [
          "column",
          "histogram"
        ]
      }
    },
    "showResponseRate": {
      "type": "boolean",
      "label": {
        "en": "Response rate",
        "fr": "Taux de réponse"
      },
      "default": true,
      "row": "checksRow",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      },
      "description": {
        "en": "The n/N bar showing how many respondents answered this question.",
        "fr": "La barre n/N indiquant combien de répondants ont répondu à cette question."
      }
    },
    "colorPalette": {
      "type": "select",
      "label": {
        "en": "Color palette",
        "fr": "Palette"
      },
      "default": "default",
      "optionPreview": "palette",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      },
      "visibleWhen": {
        "field": "chart",
        "values": [
          "pie",
          "donut"
        ]
      },
      "options": [
        {
          "value": "default",
          "label": {
            "en": "Default",
            "fr": "Par défaut"
          }
        },
        {
          "value": "tableau10",
          "label": {
            "en": "Tableau 10",
            "fr": "Tableau 10"
          }
        },
        {
          "value": "pastel",
          "label": {
            "en": "Pastel",
            "fr": "Pastel"
          }
        },
        {
          "value": "vivid",
          "label": {
            "en": "Vivid",
            "fr": "Vif"
          }
        },
        {
          "value": "cool",
          "label": {
            "en": "Cool",
            "fr": "Froide"
          }
        }
      ]
    },
    "color": {
      "type": "color-select",
      "label": {
        "en": "Main",
        "fr": "Principale"
      },
      "default": "blue",
      "row": "colorsRow",
      "section": {
        "en": "Style",
        "fr": "Style",
        "defaultOpen": false
      },
      "description": {
        "en": "Bar and histogram color.",
        "fr": "Couleur des barres et de l'histogramme."
      }
    }
  }
}
