{
  "id": "linkr-analysis-plot-builder",
  "name": {
    "en": "Plot Builder",
    "fr": "Constructeur de graphiques"
  },
  "description": {
    "en": "Interactive plot builder: scatter, line, bar, histogram, pie/donut, boxplot, and violin plots with grouping, colors, and labels.",
    "fr": "Constructeur interactif de graphiques : nuages de points, lignes, barres, histogrammes, camemberts/anneaux, boîtes à moustaches et violons avec regroupement, couleurs et légendes."
  },
  "version": "1.1.0",
  "category": "visualization",
  "tags": [
    "chart",
    "plot",
    "scatter",
    "histogram",
    "boxplot",
    "visualization"
  ],
  "runtime": [
    "component"
  ],
  "languages": [],
  "icon": "ChartScatter",
  "iconColor": "violet",
  "configSchema": {
    "xColumn": {
      "type": "column-select",
      "label": {
        "en": "X variable",
        "fr": "Variable X"
      },
      "optional": true,
      "row": "columns",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "hintWhen": {
        "field": "plotType",
        "values": {
          "scatter": {
            "en": "required",
            "fr": "requis"
          },
          "line": {
            "en": "required",
            "fr": "requis"
          },
          "bar": {
            "en": "required",
            "fr": "requis"
          },
          "histogram": {
            "en": "required",
            "fr": "requis"
          },
          "pie": {
            "en": "required",
            "fr": "requis"
          },
          "boxplot": {
            "en": "categories",
            "fr": "catégories"
          },
          "violin": {
            "en": "categories",
            "fr": "catégories"
          }
        },
        "override": [
          {
            "field": "histogramOrientation",
            "value": "horizontal",
            "values": {
              "histogram": {
                "en": "not used",
                "fr": "non utilisé"
              }
            }
          },
          {
            "field": "boxplotOrientation",
            "value": "horizontal",
            "values": {
              "boxplot": {
                "en": "numeric",
                "fr": "numérique"
              },
              "violin": {
                "en": "numeric",
                "fr": "numérique"
              }
            }
          }
        ]
      }
    },
    "yColumn": {
      "type": "column-select",
      "label": {
        "en": "Y variable",
        "fr": "Variable Y"
      },
      "optional": true,
      "row": "columns",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "hintWhen": {
        "field": "plotType",
        "values": {
          "scatter": {
            "en": "required",
            "fr": "requis"
          },
          "line": {
            "en": "required",
            "fr": "requis"
          },
          "bar": {
            "en": "optional",
            "fr": "optionnel"
          },
          "histogram": {
            "en": "not used",
            "fr": "non utilisé"
          },
          "pie": {
            "en": "not used",
            "fr": "non utilisé"
          },
          "boxplot": {
            "en": "numeric",
            "fr": "numérique"
          },
          "violin": {
            "en": "numeric",
            "fr": "numérique"
          }
        },
        "override": [
          {
            "field": "histogramOrientation",
            "value": "horizontal",
            "values": {
              "histogram": {
                "en": "required",
                "fr": "requis"
              }
            }
          },
          {
            "field": "boxplotOrientation",
            "value": "horizontal",
            "values": {
              "boxplot": {
                "en": "categories",
                "fr": "catégories"
              },
              "violin": {
                "en": "categories",
                "fr": "catégories"
              }
            }
          }
        ]
      }
    },
    "uniquePer": {
      "type": "column-select",
      "label": {
        "en": "Unique per",
        "fr": "Unique par"
      },
      "optional": true,
      "row": "unique",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Group rows by this column to get one value per entity. Example: group by patient_id to get one value per patient.",
        "fr": "Regroupe les lignes selon cette colonne pour obtenir une valeur par entité. Exemple : grouper par patient_id pour une valeur par patient."
      }
    },
    "uniqueAggregation": {
      "type": "select",
      "label": {
        "en": "Per-entity function",
        "fr": "Fonction par entité"
      },
      "default": "first",
      "row": "unique",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "visibleWhen": {
        "field": "uniquePer",
        "notEmpty": true
      },
      "description": {
        "en": "How to reduce multiple rows into one value per entity. Use \"First\" for values that are the same across rows (e.g. age), or \"Mean\" to average measurements.",
        "fr": "Comment réduire plusieurs lignes en une valeur par entité. Utilisez « Premier » pour les valeurs identiques (ex : âge), ou « Moyenne » pour moyenner des mesures."
      },
      "options": [
        {
          "value": "first",
          "label": {
            "en": "First value",
            "fr": "Première valeur"
          }
        },
        {
          "value": "last",
          "label": {
            "en": "Last value",
            "fr": "Dernière valeur"
          }
        },
        {
          "value": "mean",
          "label": {
            "en": "Mean",
            "fr": "Moyenne"
          }
        },
        {
          "value": "median",
          "label": {
            "en": "Median",
            "fr": "Médiane"
          }
        },
        {
          "value": "min",
          "label": {
            "en": "Min",
            "fr": "Min"
          }
        },
        {
          "value": "max",
          "label": {
            "en": "Max",
            "fr": "Max"
          }
        },
        {
          "value": "sum",
          "label": {
            "en": "Sum",
            "fr": "Somme"
          }
        }
      ]
    },
    "groupColumn": {
      "type": "column-select",
      "label": {
        "en": "Group / Fill",
        "fr": "Groupe / Remplissage"
      },
      "optional": true,
      "row": "group",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Split data into groups by this column. Each group gets a different color.",
        "fr": "Sépare les données en groupes selon cette colonne. Chaque groupe a une couleur différente."
      }
    },
    "excludeNA": {
      "type": "boolean",
      "label": {
        "en": "Exclude NA / missing",
        "fr": "Exclure NA / manquants"
      },
      "default": true,
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Remove rows where X or Y values are null, empty, or NA before plotting.",
        "fr": "Supprime les lignes où les valeurs X ou Y sont nulles, vides ou NA avant de tracer."
      }
    },
    "outlierMethod": {
      "type": "select",
      "label": {
        "en": "Exclude outliers",
        "fr": "Exclure les valeurs aberrantes"
      },
      "default": "none",
      "row": "outlierRow",
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "Drop extreme values before plotting. Excluded rows are removed from the computation, and the count is shown under the chart.",
        "fr": "Écarte les valeurs extrêmes avant de tracer. Les lignes exclues sont retirées du calcul, et leur nombre est indiqué sous le graphique."
      },
      "setFieldsOnChange": {
        "iqr": { "outlierCoef": 1.5 },
        "sd": { "outlierCoef": 3 },
        "percentile": { "outlierCoef": 1 }
      },
      "options": [
        {
          "value": "none",
          "label": {
            "en": "Keep all",
            "fr": "Tout garder"
          }
        },
        {
          "value": "iqr",
          "label": {
            "en": "IQR (Tukey)",
            "fr": "IQR (Tukey)"
          }
        },
        {
          "value": "sd",
          "label": {
            "en": "Standard deviation",
            "fr": "Écart-type"
          }
        },
        {
          "value": "percentile",
          "label": {
            "en": "Percentiles",
            "fr": "Percentiles"
          }
        }
      ]
    },
    "outlierCoef": {
      "type": "number",
      "label": {
        "en": "Threshold",
        "fr": "Seuil"
      },
      "default": 1.5,
      "min": 0,
      "max": 50,
      "step": 0.5,
      "row": "outlierRow",
      "visibleWhen": {
        "field": "outlierMethod",
        "values": ["iqr", "sd", "percentile"]
      },
      "section": {
        "en": "Data",
        "fr": "Données"
      },
      "description": {
        "en": "IQR: k in Q1−k·IQR / Q3+k·IQR (1.5 = Tukey). Standard deviation: k in mean ± k·SD (3 = the 3σ rule). Percentiles: the tail percentage cut from each side (1 = keep the 1st–99th).",
        "fr": "IQR : k dans Q1−k·IQR / Q3+k·IQR (1,5 = Tukey). Écart-type : k dans moyenne ± k·SD (3 = règle des 3σ). Percentiles : pourcentage écarté de chaque côté (1 = garder du 1er au 99e)."
      }
    },
    "plotType": {
      "type": "select",
      "label": {
        "en": "Plot type",
        "fr": "Type de graphique"
      },
      "default": "scatter",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "options": [
        {
          "value": "scatter",
          "label": {
            "en": "Scatter plot",
            "fr": "Nuage de points"
          }
        },
        {
          "value": "line",
          "label": {
            "en": "Line plot",
            "fr": "Lignes"
          }
        },
        {
          "value": "bar",
          "label": {
            "en": "Bar chart",
            "fr": "Barres"
          }
        },
        {
          "value": "histogram",
          "label": {
            "en": "Histogram",
            "fr": "Histogramme"
          }
        },
        {
          "value": "pie",
          "label": {
            "en": "Pie / donut",
            "fr": "Camembert / anneau"
          }
        },
        {
          "value": "boxplot",
          "label": {
            "en": "Boxplot",
            "fr": "Boîte à moustaches"
          }
        },
        {
          "value": "violin",
          "label": {
            "en": "Violin",
            "fr": "Violon"
          }
        }
      ]
    },
    "histogramOrientation": {
      "type": "select",
      "label": {
        "en": "Orientation",
        "fr": "Orientation"
      },
      "default": "vertical",
      "visibleWhen": {
        "field": "plotType",
        "value": "histogram"
      },
      "row": "orientationRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "swapFieldsOnChange": [
        [
          "xColumn",
          "yColumn"
        ],
        [
          "xLabel",
          "yLabel"
        ]
      ],
      "options": [
        {
          "value": "vertical",
          "label": {
            "en": "Vertical bars",
            "fr": "Barres verticales"
          }
        },
        {
          "value": "horizontal",
          "label": {
            "en": "Horizontal bars",
            "fr": "Barres horizontales"
          }
        }
      ]
    },
    "boxplotOrientation": {
      "type": "select",
      "label": {
        "en": "Orientation",
        "fr": "Orientation"
      },
      "default": "vertical",
      "visibleWhen": {
        "field": "plotType",
        "values": [
          "boxplot",
          "violin"
        ]
      },
      "row": "orientationRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "swapFieldsOnChange": [
        [
          "xColumn",
          "yColumn"
        ],
        [
          "xLabel",
          "yLabel"
        ]
      ],
      "options": [
        {
          "value": "vertical",
          "label": {
            "en": "Vertical",
            "fr": "Verticale"
          }
        },
        {
          "value": "horizontal",
          "label": {
            "en": "Horizontal",
            "fr": "Horizontale"
          }
        }
      ]
    },
    "barMode": {
      "type": "select",
      "label": {
        "en": "Bar mode",
        "fr": "Mode des barres"
      },
      "default": "grouped",
      "row": "variantRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "visibleWhen": [
        {
          "field": "plotType",
          "value": "histogram"
        },
        {
          "field": "groupColumn",
          "notEmpty": true
        }
      ],
      "options": [
        {
          "value": "grouped",
          "label": {
            "en": "Grouped",
            "fr": "Groupées"
          }
        },
        {
          "value": "stacked",
          "label": {
            "en": "Stacked",
            "fr": "Empilées"
          }
        },
        {
          "value": "overlay",
          "label": {
            "en": "Overlay",
            "fr": "Superposées"
          }
        }
      ]
    },
    "barStyle": {
      "type": "select",
      "label": {
        "en": "Bar style",
        "fr": "Style des barres"
      },
      "default": "classic",
      "row": "variantRow",
      "visibleWhen": {
        "field": "plotType",
        "value": "histogram"
      },
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Ranked list: one row per category with a thin bar and its count, sorted by count. Applies to a categorical variable; numeric bins and a split by another column keep the classic bars.",
        "fr": "Liste classée : une ligne par catégorie avec une barre fine et son effectif, triée par effectif. S'applique à une variable catégorielle ; les classes numériques et un regroupement par une autre colonne gardent les barres classiques."
      },
      "options": [
        {
          "value": "classic",
          "label": {
            "en": "Classic",
            "fr": "Classique"
          }
        },
        {
          "value": "list",
          "label": {
            "en": "Ranked list",
            "fr": "Liste classée"
          }
        }
      ]
    },
    "boxStyle": {
      "type": "select",
      "label": {
        "en": "Box style",
        "fr": "Style des boîtes"
      },
      "default": "filled",
      "visibleWhen": {
        "field": "plotType",
        "value": "boxplot"
      },
      "row": "variantRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Outline: a light box with a coloured border and a thick median line labelled with its value, so medians are what the eye compares.",
        "fr": "Épuré : une boîte légère au contour coloré et une médiane épaisse annotée de sa valeur, pour que l'œil compare les médianes."
      },
      "options": [
        {
          "value": "filled",
          "label": {
            "en": "Filled",
            "fr": "Plein"
          }
        },
        {
          "value": "outline",
          "label": {
            "en": "Outline",
            "fr": "Épuré"
          }
        }
      ]
    },
    "categoryOrder": {
      "type": "select",
      "label": {
        "en": "Category order",
        "fr": "Ordre des catégories"
      },
      "default": "value-desc",
      "defaultWhen": [
        {
          "when": {
            "field": "sortByMedian",
            "value": true
          },
          "value": "value-desc"
        },
        {
          "when": {
            "field": "plotType",
            "values": [
              "boxplot",
              "violin"
            ]
          },
          "value": "data"
        },
        {
          "when": [
            {
              "field": "plotType",
              "value": "bar"
            },
            {
              "anyOf": [
                {
                  "field": "yColumn",
                  "notEmpty": true
                },
                {
                  "field": "groupColumn",
                  "notEmpty": true
                }
              ]
            }
          ],
          "value": "data"
        }
      ],
      "visibleWhen": {
        "field": "plotType",
        "values": [
          "bar",
          "histogram",
          "pie",
          "boxplot",
          "violin"
        ]
      },
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Order of the categories along the axis, or of the slices. The value is what the chart plots: the count, the mean of Y for a bar chart with a Y, the median for a boxplot or violin. Applied before the category cap (30 bars, 20 boxes), so a sorted chart keeps its top categories. By default counts are ordered by descending value, and boxes, violins and bars with a Y or a group keep the data order. On a histogram it only applies to a categorical variable.",
        "fr": "Ordre des catégories le long de l'axe, ou des parts. La valeur est ce que trace le graphique : l'effectif, la moyenne de Y pour des barres avec un Y, la médiane pour une boîte ou un violon. Appliqué avant la limite de catégories (30 barres, 20 boîtes) : un graphique trié garde ses premières catégories. Par défaut, les effectifs sont triés par valeur décroissante, et les boîtes, violons et barres avec un Y ou un groupe gardent l'ordre des données. Sur un histogramme, il ne s'applique qu'à une variable catégorielle."
      },
      "options": [
        {
          "value": "value-desc",
          "label": {
            "en": "Value, descending",
            "fr": "Valeur décroissante"
          }
        },
        {
          "value": "value-asc",
          "label": {
            "en": "Value, ascending",
            "fr": "Valeur croissante"
          }
        },
        {
          "value": "alpha",
          "label": {
            "en": "Alphabetical",
            "fr": "Alphabétique"
          }
        },
        {
          "value": "data",
          "label": {
            "en": "Data order",
            "fr": "Ordre des données"
          }
        },
        {
          "value": "custom",
          "label": {
            "en": "Custom",
            "fr": "Personnalisé"
          }
        }
      ]
    },
    "categoryOrderCustom": {
      "type": "choice-order",
      "choices": "column-values",
      "label": {
        "en": "Custom order",
        "fr": "Ordre personnalisé"
      },
      "columnField": "xColumn",
      "columnFieldWhen": [
        {
          "when": [
            {
              "field": "plotType",
              "value": "histogram"
            },
            {
              "field": "histogramOrientation",
              "value": "horizontal"
            }
          ],
          "columnField": "yColumn"
        },
        {
          "when": [
            {
              "field": "plotType",
              "values": [
                "boxplot",
                "violin"
              ]
            },
            {
              "field": "boxplotOrientation",
              "value": "horizontal"
            }
          ],
          "columnField": "yColumn"
        }
      ],
      "visibleWhen": [
        {
          "field": "plotType",
          "values": [
            "bar",
            "histogram",
            "pie",
            "boxplot",
            "violin"
          ]
        },
        {
          "field": "categoryOrder",
          "value": "custom"
        }
      ],
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Drag the categories into the order the chart should read. Categories missing from this list come after it, by descending value.",
        "fr": "Glissez les catégories dans l'ordre de lecture du graphique. Les catégories absentes de cette liste viennent ensuite, par valeur décroissante."
      }
    },
    "binMode": {
      "type": "select",
      "label": {
        "en": "Bin mode",
        "fr": "Mode bins"
      },
      "default": "count",
      "visibleWhen": {
        "field": "plotType",
        "value": "histogram"
      },
      "row": "binRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "options": [
        {
          "value": "count",
          "label": {
            "en": "Number of bins",
            "fr": "Nombre de barres"
          }
        },
        {
          "value": "width",
          "label": {
            "en": "Bin width",
            "fr": "Largeur de barre"
          }
        }
      ]
    },
    "bins": {
      "type": "number",
      "label": {
        "en": "Bins",
        "fr": "Barres"
      },
      "default": 20,
      "min": 2,
      "max": 200,
      "visibleWhen": [
        {
          "field": "plotType",
          "value": "histogram"
        },
        {
          "field": "binMode",
          "value": "count"
        }
      ],
      "row": "binRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    "binWidth": {
      "type": "number",
      "label": {
        "en": "Bin width",
        "fr": "Largeur"
      },
      "default": 5,
      "min": 0.1,
      "max": 1000,
      "visibleWhen": [
        {
          "field": "plotType",
          "value": "histogram"
        },
        {
          "field": "binMode",
          "value": "width"
        }
      ],
      "row": "binRow",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    "showCount": {
      "type": "boolean",
      "label": {
        "en": "Show counts (n)",
        "fr": "Afficher les effectifs (n)"
      },
      "default": false,
      "visibleWhen": {
        "field": "plotType",
        "values": [
          "boxplot",
          "violin"
        ]
      },
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      },
      "description": {
        "en": "Add the number of values (n = …) to each category label.",
        "fr": "Ajoute le nombre de valeurs (n = …) à l'étiquette de chaque catégorie."
      }
    },
    "xLabel": {
      "type": "string",
      "label": {
        "en": "X axis label",
        "fr": "Légende axe X"
      },
      "default": "",
      "visibleWhen": {
        "field": "plotType",
        "values": [
          "scatter",
          "line",
          "bar",
          "histogram",
          "boxplot",
          "violin"
        ]
      },
      "row": "axisLabels",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    "yLabel": {
      "type": "string",
      "label": {
        "en": "Y axis label",
        "fr": "Légende axe Y"
      },
      "default": "",
      "visibleWhen": {
        "field": "plotType",
        "values": [
          "scatter",
          "line",
          "bar",
          "histogram",
          "boxplot",
          "violin"
        ]
      },
      "row": "axisLabels",
      "section": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    "xLabelMaxLen": {
      "type": "number",
      "label": {
        "en": "X label length",
        "fr": "Longueur labels X"
      },
      "default": 20,
      "min": 3,
      "max": 60,
