            "fr": "Écart-type"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "min",
          "label": {
            "en": "Min",
            "fr": "Min"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "max",
          "label": {
            "en": "Max",
            "fr": "Max"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "q1",
          "label": {
            "en": "Q1 (25th)",
            "fr": "Q1 (25e)"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "q3",
          "label": {
            "en": "Q3 (75th)",
            "fr": "Q3 (75e)"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "iqr",
          "label": {
            "en": "IQR",
            "fr": "IQR"
          },
          "onlyForColumnType": "numeric"
        }
      ]
