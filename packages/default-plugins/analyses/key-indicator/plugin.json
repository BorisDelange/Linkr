            "en": "n (count)",
            "fr": "n (effectif)"
          }
        },
        {
          "value": "mean",
          "label": {
            "en": "Mean",
            "fr": "Moyenne"
          },
          "onlyForColumnType": "numeric"
        },
        {
          "value": "median",
          "label": {
