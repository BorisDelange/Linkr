    "showTrend": {
      "type": "boolean",
      "label": {
        "en": "Trend vs previous period",
        "fr": "Tendance vs période précédente"
      },
      "default": false,
      "row": "trend",
      "section": {
        "en": "Content",
        "fr": "Contenu"
      },
      "description": {
        "en": "Compares the value with the period just before the dashboard's date filter (6 months selected → the 6 months before). Shown only while a closed date range is applied.",
        "fr": "Compare la valeur à la période qui précède le filtre de date du dashboard (6 mois sélectionnés → les 6 mois d’avant). Affichée seulement quand une plage de dates fermée est appliquée."
      }
    },
    "trendDirection": {
