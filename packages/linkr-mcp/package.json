{
  "name": "@linkr/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "linkr-mcp": "./src/live/server.ts"
  },
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/live/server.ts",
    "start:http": "tsx --tsconfig tsconfig.json src/live/http.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "skill:pack": "rm -f dist/concept-mapping.zip && mkdir -p dist && cd skills && zip -rq ../dist/concept-mapping.zip concept-mapping -x 'concept-mapping/TODO.md' '*/__pycache__/*' '*.pyc' '*/.DS_Store'",
    "docs:snapshot": "tsx --tsconfig tsconfig.json src/docs-snapshot.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "i18next": "^25.8.7"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
