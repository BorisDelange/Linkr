# Configuration of the live server. Copy to .env (gitignored).
LINKR_API_URL=http://localhost:8000

# stdio entry (src/live/server.ts, Claude Code): the agent acts as this user and can
# never do more than this account may. Prefer a personal API key (Profile → API keys
# in Linkr, "lnk_…"); username + password also work.
LINKR_TOKEN=
# LINKR_USERNAME=
# LINKR_PASSWORD=

# HTTP entry (src/live/http.ts, LibreChat…): each client sends its OWN Linkr API key
# as "Authorization: Bearer lnk_…" and acts as that user — nothing to set here.
# Optional single-user mode: a shared key that acts with the credentials above.
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# LINKR_MCP_KEY=
# LINKR_MCP_PORT=3940
# LINKR_MCP_HOST=127.0.0.1

# Documentation search (search_docs / read_doc) reads the index the website publishes.
# Override with another URL, or a local linkr-website build: .../linkr-website/dist/docs-index.json
# Without internet, the copy shipped in data/docs-index.json.gz is used (npm run docs:snapshot refreshes it).
# LINKR_DOCS_INDEX=https://linkr.interhop.org/docs-index.json

# Tools exposed directly (default: a core of ~30 common ones; every other tool is
# reached through find_linkr_tools + run_linkr_read/write/delete_tool). Add families
# on top of the core, comma-separated, or "all" for every tool with no gateway — right
# for clients that load tools on demand (Claude Code: see the repo's .mcp.json).
# Families: context, workspace, warehouse, dq, lab, ide, mapping, etl, wiki, git
# LINKR_MCP_TOOLSETS=mapping
