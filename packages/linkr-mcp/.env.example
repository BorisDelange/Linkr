# Credentials for the live server (src/live/server.ts). Copy to .env (gitignored).
# The agent acts as this user: it can never do more than this account may.
LINKR_API_URL=http://localhost:8000
LINKR_USERNAME=
LINKR_PASSWORD=
# Or an access token instead of username + password:
# LINKR_TOKEN=

# HTTP entry (src/live/http.ts), for clients that take a URL (LibreChat…):
# the key they must send as "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Generate one: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
LINKR_MCP_KEY=
# LINKR_MCP_PORT=3940
