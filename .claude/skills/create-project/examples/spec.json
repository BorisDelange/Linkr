{
  "appVersion": "2.0.20",
  "project": {
    "projectId": "icu-activity",
    "name": {"en": "ICU Activity", "fr": "Activité de réanimation"},
    "description": {
      "en": "Synthetic ICU activity, severity, and outcomes demo.",
      "fr": "Démo synthétique d'activité, de gravité et de devenir en réanimation."
    },
    "readmeFile": "README.md",
    "todos": [
      {"text": "Review mortality by unit with the clinical team", "done": false},
      {"text": "Add a LOS vs SOFA scatter", "done": false}
    ],
    "notes": "All data is synthetic — see README.",
    "badges": [
      {"label": "ICU", "color": "red"},
      {"label": "Demo", "color": "blue"}
    ]
  },
  "ide": [
    {"path": "mortality_analysis.py", "file": "scripts/mortality_analysis.py"},
    {"path": "los_summary.r", "file": "scripts/los_summary.r"}
  ],
  "datasets": [
    {
      "slug": "icu-stays",
      "name": "ICU stays",
      "csv": "icu-stays.csv",
      "types": {"admission_datetime": "date"}
    }
  ],
  "dashboards": [
    {
      "name": "ICU Activity",
      "showWidgetTitles": true,
      "filters": [
        {"dataset": "icu-stays", "column": "sex"},
        {"dataset": "icu-stays", "column": "icu_unit", "label": "ICU unit"},
        {"dataset": "icu-stays", "column": "age"}
      ],
      "tabs": [
        {
          "name": "Demographics",
          "widgets": [
            {"kind": "kpi", "dataset": "icu-stays", "name": "Unique patients",
             "column": "person_id", "uniquePer": "person_id", "aggregate": "count",
             "icon": "Users", "color": "blue", "w": 12},
            {"kind": "kpi", "dataset": "icu-stays", "name": "ICU mortality",
             "column": "deceased_in_icu", "aggregate": "proportion", "targetValue": "1",
             "icon": "HeartPulse", "color": "red", "decimals": 1, "chartType": "pie", "w": 12},
            {"kind": "kpi", "dataset": "icu-stays", "name": "Median age",
             "column": "age", "aggregate": "median", "unit": "yr",
             "icon": "Calendar", "color": "slate", "w": 12},
            {"kind": "kpi", "dataset": "icu-stays", "name": "Ventilation rate",
             "column": "mechanical_ventilation", "aggregate": "proportion", "targetValue": "1",
             "icon": "Activity", "color": "orange", "decimals": 1, "w": 12},
            {"kind": "plot", "dataset": "icu-stays", "name": "Age distribution by sex",
             "plotType": "histogram", "xColumn": "age", "groupColumn": "sex",
             "binMode": "width", "binWidth": 5, "xLabel": "Age", "yLabel": "Count", "w": 24},
            {"kind": "plot", "dataset": "icu-stays", "name": "Stays per unit",
             "plotType": "bar", "xColumn": "icu_unit", "xLabel": "Unit", "yLabel": "Stays", "w": 24}
          ]
        },
        {
          "name": "Severity & outcomes",
          "widgets": [
            {"kind": "kpi", "dataset": "icu-stays", "name": "Median SOFA",
             "column": "sofa_score", "aggregate": "median",
             "icon": "Stethoscope", "color": "purple", "w": 12},
            {"kind": "kpi", "dataset": "icu-stays", "name": "Median LOS",
             "column": "los_days", "aggregate": "median", "unit": "d", "decimals": 1,
             "icon": "BedDouble", "color": "teal", "w": 12},
            {"kind": "plot", "dataset": "icu-stays", "name": "LOS distribution",
             "plotType": "histogram", "xColumn": "los_days",
             "binMode": "width", "binWidth": 1, "xLabel": "LOS (days)", "yLabel": "Count", "w": 24},
            {"kind": "plot", "dataset": "icu-stays", "name": "SOFA by unit",
             "plotType": "box", "xColumn": "icu_unit", "yColumn": "sofa_score",
             "xLabel": "Unit", "yLabel": "SOFA", "w": 48},
            {"kind": "plugin", "pluginId": "linkr-analysis-table1", "dataset": "icu-stays",
             "name": "Baseline characteristics by outcome",
             "config": {
               "selectedColumns": ["age", "sex", "sofa_score", "los_days", "mechanical_ventilation"],
               "groupByColumn": "deceased_in_icu",
               "metrics": ["n", "mean_sd", "median_iqr"]
             }, "w": 48}
          ]
        }
      ]
    }
  ]
}
